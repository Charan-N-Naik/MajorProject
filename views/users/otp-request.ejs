<% layout("/layouts/boilerplate") %>
<h1 class="col-6 offset-4">Login via OTP</h1>
<div class="row mt-3">
    <div class="col-6 offset-3">
        <form action="/send-otp" method="POST" novalidate class="needs-validation">
            <div class="mt-3">
                <label for="email" class="form-label">Email Address</label>
                <input 
                    name="email" 
                    id="email"
                    class="form-control" 
                    type="email" 
                    required
                />
                <div class="invalid-feedback">
                    Please provide a valid registered email.
                </div>
            </div>
            <button class="btn btn-success mt-4">Send OTP</button>
            <a href="/login" class="btn btn-outline-secondary mt-4 ms-2">Login with Password</a>
        </form>
    </div>
</div>
