
<% layout('/layouts/boilerplate') %>
<!-- heare useing the that craeted templete where it contain defoult content and the body parameter that content containe below -->
<body>
    <div class="mt-3">
         <h3 class="mt-3">Wellcome to Listing</h3>
    </div> 
   
    <!-- <form method="get" action="/listing/new">
        <button>add new Listing</button>
    </form> -->
    <div class="row row-cols-lg-3  row-cols-md-2 row-cols-sm-1 mt-3">
    <% for(let list of allListings) {%>
        <a style="text-decoration: none;" href="/listing/<%= list._id %> ">
            <div class="card" >
                <img src="<%=list.image.url%>" class="card-img-top" alt="listing_image" style="height: 20rem;">
                <div class="card-img-overlay">overlay</div>
                <div class="card-body">
                    <p class="card-text">
                    <b> <%= list.title %></b> <br>
                        &#8377;<%=list.price.toLocaleString("en-IN")%></li>/night
                    </p>
                </div>
            </div>
        </a>
    <% } %>
    </div>
</body>
