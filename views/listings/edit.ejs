<% layout("/layouts/boilerplate") %>
<body>
    <div class="row mt-3">
        <div class="col-8 offset-2" > 
            
            <h1>Edit The Listing</h1>
            <form method="post"  action="/listing/<%=listtoedit._id  %>?__method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input name="listing[title]" value="<%=listtoedit.title  %>" type="text" class="form-control" required/>
                    <div class="invalid-feedback">country should be valid</div>
                </div>
                
                <div class="mb-3">
                    <label for="description" class="form-label">description</label>
                    <textarea name="listing[description]" class="form-control" required><%=listtoedit.description%></textarea>
                    <div class="invalid-feedback">please enter the valid short description</div>

                </div>
                <div class="mb-3">
                    <h3>Original image</h3>
                    <img src="<%= resizedimg %>">
                </div>

                <div class="mb-3">
                    <label for="image" class="form-label">image url/link</label>
                    <input name="listing[image]"   type="file" class="form-control" />
                    <div class="invalid-feedback">img url should be valid</div>
                </div>
                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label">price</label>
                        <input name="listing[price]" value="<%=listtoedit.price%>" type="number" class="form-control" required />
                        <div class="invalid-feedback">price should be valid</div>
                    </div>

                    <div class="mb-3 col-md-8"> 
                        <label for="country" class="form-label">country</label>
                        <input name="listing[country]" value="<%=listtoedit.country%>" type="text" class="form-control" required/>
                        <div class="invalid-feedback">country should be valid</div>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="location" class="form-label">location</label>
                    <input name="listing[location]" value="<%=listtoedit.location%>" type="text" class="form-control" required/>
                    <div class="invalid-feedback">location should be valid</div>
                </div>
                <div class="mb-3">
                    <label for="category" class="form-label">choose a category</label>
                    <select id="category" name="listing[categerory]" class="form-select" aria-label="Default select example" required>
                        <option value="">Select a category</option>
                        <option value="Treanding" <% if(listtoedit.categerory === "Treanding") { %>selected<% } %>>Trending</option>
                        <option value="Rooms" <% if(listtoedit.categerory === "Rooms") { %>selected<% } %>>Rooms</option>
                        <option value="Iconic Cities" <% if(listtoedit.categerory === "Iconic Cities") { %>selected<% } %>>Iconic Cities</option>
                        <option value="Mountain" <% if(listtoedit.categerory === "Mountain") { %>selected<% } %>>Mountain</option>
                        <option value="Camping" <% if(listtoedit.categerory === "Camping") { %>selected<% } %>>Camping</option>
                        <option value="Castle" <% if(listtoedit.categerory === "Castle") { %>selected<% } %>>Castle</option>
                        <option value="Pools" <% if(listtoedit.categerory === "Pools") { %>selected<% } %>>Pools</option>
                        <option value="Farms" <% if(listtoedit.categerory === "Farms") { %>selected<% } %>>Farms</option>
                        <option value="Arctic" <% if(listtoedit.categerory === "Arctic") { %>selected<% } %>>Arctic</option>
                        <option value="Beach" <% if(listtoedit.categerory === "Beach") { %>selected<% } %>>Beach</option>
                        <option value="Desert" <% if(listtoedit.categerory === "Desert") { %>selected<% } %>>Desert</option>
                        <option value="Forest" <% if(listtoedit.categerory === "Forest") { %>selected<% } %>>Forest</option>
                        <option value="Sports" <% if(listtoedit.categerory === "Sports") { %>selected<% } %>>Sports</option>
                    </select>
                    <div class="invalid-feedback">please select a category</div>
                </div>
                <button class="btn btn-dark edit-btn mt-3">Edit</button>
            </form>
           <br>
           <br>
        </div> 
     </div>
</body>
